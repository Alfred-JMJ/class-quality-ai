# Groq transcription configuration
GROQ_API_KEY=<grok key>
GROQ_MODEL=whisper-large-v3

# Maximum audio file size sent in a single Groq request, in MiB
GROQ_MAX_FILE_SIZE_MB=25

# API request timeout in seconds
GROQ_TIMEOUT_SECONDS=120

# Local faster-whisper configuration
LOCAL_WHISPER_MODEL=tiny
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_CPU_THREADS=4
LOCAL_WHISPER_BEAM_SIZE=3
LOCAL_WHISPER_VAD_FILTER=true


# Transcription service configuration
TRANSCRIPTION_FALLBACK_ENABLED=true


# Audio analysis configuration
AUDIO_FRAME_DURATION_MS=20
AUDIO_LOW_LEVEL_THRESHOLD_DBFS=-45
AUDIO_CLIPPING_THRESHOLD=0.999


# ============================================================
# MEDIA PROCESSING CONFIGURATION
# ============================================================

# FFmpeg executables
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# General command timeouts (seconds)
MEDIA_COMMAND_TIMEOUT_SECONDS=600
MEDIA_METADATA_TIMEOUT_SECONDS=60
MEDIA_FRAME_TIMEOUT_SECONDS=120

# Audio extraction
AUDIO_OUTPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_CHANNELS=1
AUDIO_OUTPUT_CODEC=pcm_s16le

# Optional compressed audio output
AUDIO_COMPRESSION_ENABLED=false
AUDIO_COMPRESSED_FORMAT=mp3
AUDIO_COMPRESSED_BITRATE=48k

# Video frame extraction
VIDEO_FRAME_OUTPUT_DIR=data/frames
VIDEO_MAX_FRAMES=8
VIDEO_JPEG_QUALITY=3
VIDEO_FRAME_START_MARGIN_SECONDS=1.0

# Silence detection
SILENCE_DETECTION_ENABLED=true
SILENCE_NOISE_THRESHOLD_DB=-40
SILENCE_MIN_DURATION_SECONDS=2.0

# Transcription chunking
TRANSCRIPTION_CHUNK_SECONDS=300

# ============================================================
# MEDIA PIPELINE OUTPUT
# ============================================================

MEDIA_PIPELINE_OUTPUT_DIR=data/processed

# ============================================================
# Gemini api details
# ============================================================


GEMINI_API_KEY=<gemini key>
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_MAX_IMAGE_DIMENSION=1024
GEMINI_REQUEST_TIMEOUT_SECONDS=120

# LLM assessment provider configuration
GROQ_ASSESSMENT_MODEL=openai/gpt-oss-20b
GEMINI_ASSESSMENT_MODEL=gemini-3.6-flash

# LLM input/output settings
ASSESSMENT_MAX_TRANSCRIPT_CHARS=12000
ASSESSMENT_LLM_MAX_OUTPUT_TOKENS=1800
ASSESSMENT_LLM_TEMPERATURE=0.2
ASSESSMENT_LLM_MIN_TRANSCRIPT_CHARACTERS=200

# Video upload max-size
MAX_VIDEO_UPLOAD_MB=250